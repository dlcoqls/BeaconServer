# ================================
# 환경변수 설정 가이드
# ================================
# 이 파일을 복사해서 .env 파일을 만들고
# 각자 본인의 API 키를 입력해주세요
#
# 방법:
# 1. 이 파일을 복사 → 이름을 .env 로 변경
# 2. console.groq.com  접속 → API 키 발급
# 3. 아래 YOUR_API_KEY_HERE 부분에 본인 키 붙여넣기
#
# ================================

GROQ_API_KEY=YOUR_API_KEY_HERE